# ── Dependencies ──────────────────────────────────────────────────────────
node_modules

# ── Build output ──────────────────────────────────────────────────────────
dist
app/dist
app/dist-site

# Generated by `npm run docs:build` — source lives in scripts/docs/
app/docs/*.html

# ── Secrets ───────────────────────────────────────────────────────────────
# Committing any of these is unrecoverable: GitHub retains forks and caches,
# and scrapers watch new public repos for exactly this.
.env
.env.*
!.env.example
*.mnemonic
*.seed
seed.txt
mnemonic.txt
wallet-backup*
*.keystore
keystore.json
*.key
*.pem

# Bitcoin Core credentials, if ever copied into the project
bitcoin.conf

# ── Logs and OS noise ─────────────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ── Editors ───────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
