# ── Dependencies ──────────────────────────────────────────────────────────
node_modules

# ── Build output ──────────────────────────────────────────────────────────
dist
app/dist
app/dist-site
public

# Generated by `npm run docs:build` — source lives in scripts/docs/
app/docs/*.html

# ── Secrets ───────────────────────────────────────────────────────────────
# Committing any of these is unrecoverable: GitHub retains forks and caches,
# and scrapers watch new public repos for exactly this.
.env
.env.*
!.env.example
*.mnemonic
*.seed
seed.txt
mnemonic.txt
wallet-backup*
*.keystore
keystore.json

# ...EXCEPT the security-challenge keystore, which is MEANT to be published.
# The whole point of the challenge is that anyone can attack this ciphertext,
# so it is the one keystore in this repository that must be committed. It is a
# dedicated wallet holding only the bounty, and its passphrase carries 128+ bits
# of entropy and lives offline. See README.md "The security challenge".
!challenge/keystore.json
*.key
*.pem

# Bitcoin Core credentials, if ever copied into the project
bitcoin.conf

# ── Logs and OS noise ─────────────────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# ── Editors ───────────────────────────────────────────────────────────────
.vscode
.idea
*.swp

standalone
