{
  "name": "veyra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veyra — a self-custodial Bitcoin wallet built as a cryptography learning laboratory.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo:wallet": "tsx scripts/wallet-demo.ts",
    "demo:sync": "tsx scripts/sync-demo.ts",
    "test:regtest": "vitest run tests/integration/",
    "test:unit": "vitest run tests/unit tests/cryptography tests/security tests/fuzz",
    "api": "tsx api/src/index.ts",
    "test:api": "vitest run api/tests/",
    "app": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "docs:build": "tsx scripts/build-docs.ts",
    "check:publish": "tsx scripts/prepublish-check.ts",
    "site:build": "tsx scripts/build-site.ts",
    "xpub": "tsx scripts/export-xpub.ts",
    "standalone": "tsx scripts/build-standalone.ts",
    "check:vercel": "tsx scripts/check-vercel.ts",
    "build:public": "tsx scripts/build-deploy.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}